/*
 * WTG-01 dashboard: dark control-room HUD over the 3D scene.
 * Sizes are logical (CSS-like) pixels; ResponsivePanel scales the panel by the device pixel ratio.
 * Layout variants come from classes on the root: .dashboard--landscape (PC), .dashboard--portrait (phone),
 * .dashboard--short (low landscape screens). USS has no media queries.
 * Selectors that restyle built-in controls (Button, Slider) are prefixed with .dashboard so they outrank the
 * default runtime theme, including its :hover / :active states.
 */

:root {
    --ground: #0D1820;
    --panel: rgba(19, 35, 45, 0.82);
    --panel-solid: #13232D;
    --line: rgba(140, 162, 174, 0.18);
    --line-strong: rgba(140, 162, 174, 0.34);
    --ink: #E4EDF1;
    --ink-2: #B7C7CF;
    --muted: #8CA2AE;
    --accent: #5CC6E0;
    --accent-dim: rgba(92, 198, 224, 0.16);
    --hover: rgba(140, 162, 174, 0.14);
    --good: #45C08A;
    --good-dim: rgba(69, 192, 138, 0.13);
    --good-line: rgba(69, 192, 138, 0.40);
    --warn: #F0B03C;
    --warn-dim: rgba(240, 176, 60, 0.13);
    --warn-line: rgba(240, 176, 60, 0.45);
    --crit: #EF5A4B;
    --crit-dim: rgba(239, 90, 75, 0.14);
    --crit-line: rgba(239, 90, 75, 0.50);
    --idle: #8CA2AE;
    --idle-dim: rgba(140, 162, 174, 0.12);
    --idle-line: rgba(140, 162, 174, 0.40);
    --track: rgba(140, 162, 174, 0.22);
}

/* ---------- Fonts and base ---------- */

.dashboard {
    flex-grow: 1;
    -unity-font-definition: url("Fonts/Barlow-Regular SDF.asset");
    font-size: 14px;
    color: var(--ink);
}

.unity-label {
    margin: 0;
    padding: 0;
}

.turbine-id,
.pill__label,
.card__label,
.chip,
.tab,
.fab {
    -unity-font-definition: url("Fonts/BarlowCondensed-SemiBold SDF.asset");
}

.turbine-id {
    -unity-font-definition: url("Fonts/BarlowCondensed-Bold SDF.asset");
}

.value,
.dock__value,
.segmented__item {
    -unity-font-definition: url("Fonts/IBMPlexMono-Medium SDF.asset");
}

.turbine-class,
.unit,
.card__aside,
.meta-text,
.source-badge,
.wind-tick,
.chart__placeholder {
    -unity-font-definition: url("Fonts/IBMPlexMono-Regular SDF.asset");
}

/* Invisible, under the whole dashboard: presses on the empty scene orbit and zoom the camera. */
.scene-input,
.callout-layer {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
}

/* ---------- 3D callouts (SceneCallout, moved with translate to the projected anchor) ---------- */

.callout {
    position: absolute;
    left: 0;
    top: 0;
    width: 0;
    height: 0;
    opacity: 0;
    transition-property: opacity;
    transition-duration: 0.3s;
    color: var(--accent);
}

.callout--on {
    opacity: 1;
}

.callout--warn {
    color: var(--warn);
}

/* Box around the anchor; SceneCallout sizes it inline (it grows with the lift) and draws the leader line in it. */
.callout__line {
    position: absolute;
}

.callout__dot {
    position: absolute;
    left: -4px;
    top: -4px;
    width: 8px;
    height: 8px;
    border-radius: 4px;
    border-width: 2px;
    border-color: var(--panel-solid);
    background-color: var(--accent);
}

.callout--warn .callout__dot {
    background-color: var(--warn);
}

.callout__box {
    position: absolute;
    translate: 0 -50%;
    padding: 4px 8px 5px 8px;
    background-color: rgba(19, 35, 45, 0.88);
    border-width: 1px;
    border-left-width: 3px;
    border-color: var(--line-strong);
    border-left-color: var(--accent);
    border-radius: 6px;
}

.callout--left .callout__box {
    border-left-width: 1px;
    border-right-width: 3px;
    border-left-color: var(--line-strong);
    border-right-color: var(--accent);
    align-items: flex-end;
}

.callout--warn .callout__box {
    border-left-color: var(--warn);
}

.callout--warn.callout--left .callout__box {
    border-left-color: var(--line-strong);
    border-right-color: var(--warn);
}

.callout__title {
    -unity-font-definition: url("Fonts/BarlowCondensed-SemiBold SDF.asset");
    font-size: 12px;
    letter-spacing: 0.8px;
    color: var(--muted);
    white-space: nowrap;
}

.callout--warn .callout__title {
    color: var(--warn);
}

.callout__value {
    -unity-font-definition: url("Fonts/IBMPlexMono-Medium SDF.asset");
    font-size: 15px;
    color: var(--ink);
    white-space: nowrap;
}

/* The layer is outside #dashboard, so nothing inherits the dashboard fonts: every label sets its own. */
.callout__note {
    -unity-font-definition: url("Fonts/Barlow-Regular SDF.asset");
    font-size: 11px;
    color: var(--ink-2);
    white-space: nowrap;
}

/* ---------- Top bar ---------- */

.top-bar {
    flex-direction: row;
    align-items: center;
    height: 56px;
    padding: 0 20px;
    background-color: rgba(10, 19, 26, 0.78);
    border-bottom-width: 1px;
    border-color: var(--line);
}

.top-bar__brand {
    flex-direction: row;
    align-items: center;
    flex-grow: 1;
    flex-basis: 0;
}

.turbine-id {
    font-size: 24px;
    letter-spacing: 0.5px;
    color: var(--ink);
}

.turbine-class {
    font-size: 11px;
    color: var(--muted);
    margin-left: 10px;
}

.top-bar__status {
    flex-direction: row;
    align-items: center;
    flex-shrink: 1;
}

.state-explanation {
    width: 540px;
    font-size: 13px;
    color: var(--ink-2);
    margin-left: 12px;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
    flex-shrink: 1;
}

.top-bar__meta {
    flex-direction: row;
    align-items: center;
    justify-content: flex-end;
    flex-grow: 1;
    flex-basis: 0;
}

.meta-text {
    font-size: 12px;
    color: var(--muted);
}

.source-badge {
    font-size: 12px;
    color: var(--ink-2);
    margin-left: 14px;
    padding: 2px 8px;
    border-width: 1px;
    border-color: var(--line-strong);
    border-radius: 4px;
}

/* ---------- State pill and chip (semantic colors) ---------- */

/*
 * State changes cross-fade the colors instead of snapping. Fixed widths on the pill and the explanation keep the
 * centered status group the same size for every state, so the pill does not jump when the text changes.
 */
.pill {
    flex-direction: row;
    align-items: center;
    justify-content: center;
    min-width: 160px;
    padding: 4px 12px;
    border-width: 1px;
    border-radius: 999px;
    transition-property: background-color, border-color;
    transition-duration: 0.4s;
}

.pill__dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 7px;
    transition-property: background-color;
    transition-duration: 0.4s;
}

.pill__label {
    font-size: 14px;
    letter-spacing: 1px;
    transition-property: color;
    transition-duration: 0.4s;
}

.chip {
    font-size: 11px;
    letter-spacing: 1px;
    padding: 1px 7px;
    border-width: 1px;
    border-radius: 4px;
}

.pill--good, .chip--good { background-color: var(--good-dim); border-color: var(--good-line); }
.pill--good .pill__label, .chip--good { color: var(--good); }
.pill--good .pill__dot { background-color: var(--good); }

.pill--rated, .chip--rated { background-color: var(--accent-dim); border-color: rgba(92, 198, 224, 0.45); }
.pill--rated .pill__label, .chip--rated { color: var(--accent); }
.pill--rated .pill__dot { background-color: var(--accent); }

.pill--idle, .chip--idle { background-color: var(--idle-dim); border-color: var(--idle-line); }
.pill--idle .pill__label, .chip--idle { color: var(--idle); }
.pill--idle .pill__dot { background-color: var(--idle); }

.pill--warn, .chip--warn { background-color: var(--warn-dim); border-color: var(--warn-line); }
.pill--warn .pill__label, .chip--warn { color: var(--warn); }
.pill--warn .pill__dot { background-color: var(--warn); }

.pill--crit, .chip--crit { background-color: var(--crit-dim); border-color: var(--crit-line); }
.pill--crit .pill__label, .chip--crit { color: var(--crit); }
.pill--crit .pill__dot { background-color: var(--crit); }

/* ---------- Body and columns ---------- */

.body {
    flex-grow: 1;
    flex-direction: row;
    justify-content: space-between;
    padding: 16px;
}

/* Equal column widths keep the free space (and the dock in it) centered under the turbine. */
.left-column {
    width: 300px;
}

.right-column {
    width: 300px;
}

/* On PC, DashboardLayout places the dock here, centered at the bottom between the columns. */
.scene-space {
    flex-grow: 1;
    justify-content: flex-end;
    margin: 0 16px;
}

.scene-actions {
    display: none;
}

/* ---------- Cards ---------- */

.card {
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 10px;
    padding: 12px 14px;
    margin-bottom: 10px;
}

/* Temperature card border follows the level (after .card so it wins at equal specificity). */
.card--warn {
    border-color: var(--warn-line);
}

.card--crit {
    border-color: var(--crit-line);
}

.card__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.card__label {
    font-size: 12px;
    letter-spacing: 1.2px;
    color: var(--muted);
}

.card__aside {
    font-size: 11px;
    color: var(--muted);
    white-space: nowrap;
}

.card__aside--accent {
    color: var(--accent);
}

/* Derated power limit, lost production while a fault event lasts. */
.card__aside--warn {
    color: var(--warn);
}

.card__footer {
    flex-direction: row;
    justify-content: space-between;
    margin-top: 6px;
}

/* ValueCardsPresenter shows it once a fault event has cost production. */
.lost-row {
    display: none;
}

.lost-row--on {
    display: flex;
}

.value-row {
    flex-direction: row;
    align-items: flex-end;
    margin-top: 4px;
}

.value {
    font-size: 28px;
    color: var(--ink);
    white-space: nowrap;
}

.value--hero {
    font-size: 44px;
}

.unit {
    font-size: 13px;
    color: var(--muted);
    margin-left: 5px;
    margin-bottom: 5px;
}

.card--hero .unit {
    margin-bottom: 8px;
}

.meter {
    height: 6px;
    margin-top: 8px;
    border-radius: 3px;
    background-color: var(--track);
    overflow: hidden;
}

.meter__fill {
    height: 100%;
    width: 50%;
    border-radius: 3px;
    background-color: var(--accent);
}

/* Temperature scale: zone widths are set from the protection limits in code (flex-grow = degrees). */

.temp-scale {
    height: 12px;
    margin-top: 8px;
    justify-content: center;
}

.temp-scale__zones {
    flex-direction: row;
    height: 6px;
    border-radius: 3px;
    overflow: hidden;
}

.temp-scale__zone {
    height: 100%;
}

.temp-scale__zone--normal { flex-grow: 140; background-color: rgba(69, 192, 138, 0.45); }
.temp-scale__zone--warning { flex-grow: 10; background-color: var(--warn); }
.temp-scale__zone--alarm { flex-grow: 5; background-color: rgba(239, 90, 75, 0.70); }
.temp-scale__zone--trip { flex-grow: 15; background-color: var(--crit); }

.temp-scale__marker {
    position: absolute;
    top: 0;
    left: 26.6%;
    width: 2px;
    height: 12px;
    margin-left: -1px;
    border-radius: 1px;
    background-color: var(--ink);
}

/* ---------- Notification banner ---------- */

.notification-area {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    align-items: center;
}

/* Stays in the layout while hidden so opacity and translate can animate. */
.notification {
    flex-direction: row;
    width: 100%;
    max-width: 560px;
    padding: 10px 14px;
    background-color: var(--panel-solid);
    border-width: 1px;
    border-left-width: 4px;
    border-color: var(--line);
    border-radius: 10px;
    opacity: 0;
    translate: 0 -6px;
    transition-property: opacity, translate, border-color;
    transition-duration: 0.3s;
}

.notification--visible {
    opacity: 1;
    translate: 0 0;
}

.notification--warn {
    border-left-color: var(--warn);
}

.notification--crit {
    border-left-color: var(--crit);
}

.notification__icon {
    width: 20px;
    height: 20px;
    margin: 1px 10px 0 0;
    border-radius: 4px;
    -unity-font-definition: url("Fonts/BarlowCondensed-Bold SDF.asset");
    -unity-text-align: middle-center;
    font-size: 14px;
    color: var(--ground);
    background-color: var(--warn);
}

.notification--crit .notification__icon {
    background-color: var(--crit);
}

.notification__body {
    flex-grow: 1;
    flex-shrink: 1;
}

/* SHOW on generator banners. display (not opacity): the hidden banner must not catch taps. */
.dashboard .notification__action {
    display: none;
    align-self: center;
    flex-shrink: 0;
    margin: 0 0 0 12px;
    padding: 6px 12px;
    font-size: 13px;
    letter-spacing: 1px;
    color: var(--accent);
    background-color: var(--accent-dim);
    border-width: 1px;
    border-color: rgba(92, 198, 224, 0.5);
    border-radius: 6px;
}

.dashboard .notification__action:hover {
    background-color: var(--hover);
    color: var(--ink);
}

.dashboard .notification__action--on {
    display: flex;
}

.notification__title {
    -unity-font-definition: url("Fonts/BarlowCondensed-SemiBold SDF.asset");
    font-size: 16px;
    letter-spacing: 0.3px;
    color: var(--ink);
}

.notification__message {
    margin-top: 2px;
    font-size: 13px;
    color: var(--ink-2);
    white-space: normal;
}

/* ---------- Charts (placeholders until the chart step) ---------- */

.chart {
    margin-top: 10px;
    border-radius: 6px;
    background-color: rgba(140, 162, 174, 0.06);
    align-items: center;
    justify-content: center;
}

.chart--trend {
    height: 130px;
}

.chart--curve {
    height: 160px;
}

.chart__placeholder {
    font-size: 11px;
    color: var(--muted);
}

.chart--live {
    background-color: rgba(0, 0, 0, 0);
}

/*
 * Painter2D chart. Colors are custom properties read in C# (CustomStyleResolvedEvent), so the palette stays here.
 * Literal values: custom properties are read from this rule, not inherited from :root.
 */
.chart-canvas {
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    --chart-series: #5CC6E0;
    --chart-grid: rgba(140, 162, 174, 0.16);
    --chart-muted: #8CA2AE;
    --chart-curve: #B7C7CF;
    --chart-warn: #F0B03C;
    --chart-crit: #EF5A4B;
    --chart-surface: #13232D;
}

.chart__tick {
    position: absolute;
    -unity-font-definition: url("Fonts/IBMPlexMono-Regular SDF.asset");
    font-size: 10px;
    color: var(--muted);
    white-space: nowrap;
}

.chart__tick--y {
    left: 0;
    -unity-text-align: middle-right;
}

.chart__tick--x {
    translate: -50% 0;
}

.chart__unit {
    color: var(--muted);
}

/* Live operating point label on the power curve. */
.chart__live-label {
    position: absolute;
    -unity-font-definition: url("Fonts/IBMPlexMono-Medium SDF.asset");
    font-size: 11px;
    color: var(--ink);
    white-space: nowrap;
}

.chart__tooltip {
    position: absolute;
    top: 0;
    padding: 2px 6px;
    -unity-font-definition: url("Fonts/IBMPlexMono-Regular SDF.asset");
    font-size: 11px;
    color: var(--ink);
    white-space: nowrap;
    background-color: var(--panel-solid);
    border-width: 1px;
    border-color: var(--line-strong);
    border-radius: 4px;
}

/* ---------- Tabs, segmented buttons, floating buttons ---------- */

.tabs {
    flex-direction: row;
}

.dashboard .tab,
.dashboard .segmented__item,
.dashboard .fab {
    margin: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
    color: var(--muted);
}

.dashboard .tab {
    font-size: 11px;
    letter-spacing: 1px;
    padding: 2px 9px;
    margin-left: 2px;
    border-radius: 999px;
}

.dashboard .segmented__item {
    font-size: 12px;
    padding: 4px 10px;
    border-radius: 0;
}

.dashboard .fab {
    width: 52px;
    height: 44px;
    font-size: 12px;
    letter-spacing: 1px;
    border-radius: 12px;
    border-width: 1px;
    border-color: var(--line);
    background-color: var(--panel);
    color: var(--ink-2);
}

.dashboard .tab:hover,
.dashboard .segmented__item:hover,
.dashboard .fab:hover {
    background-color: var(--hover);
    color: var(--ink);
}

.dashboard .tab:hover:active,
.dashboard .segmented__item:hover:active,
.dashboard .fab:hover:active {
    background-color: var(--line-strong);
}

.dashboard .tab--on,
.dashboard .tab--on:hover,
.dashboard .segmented__item--on,
.dashboard .segmented__item--on:hover,
.dashboard .fab--on,
.dashboard .fab--on:hover {
    background-color: var(--accent-dim);
    color: var(--accent);
}

.dashboard .fab--on {
    border-color: rgba(92, 198, 224, 0.5);
}

/* Fault toggle while the fault is active: the same button now repairs it. */
.dashboard .segmented__item--alert,
.dashboard .segmented__item--alert:hover,
.dashboard .fab--alert,
.dashboard .fab--alert:hover {
    background-color: var(--warn-dim);
    border-color: var(--warn-line);
    color: var(--warn);
}

.dashboard .fab--fault {
    width: 60px;
    margin-bottom: 8px;
}

.segmented {
    flex-direction: row;
    margin-top: 6px;
    border-width: 1px;
    border-color: var(--line-strong);
    border-radius: 6px;
    overflow: hidden;
}

.dashboard .segmented__item--single {
    margin-top: 6px;
    border-width: 1px;
    border-color: var(--line-strong);
    border-radius: 6px;
}

/* ---------- Dock (controls) ---------- */

.dock {
    align-self: center;
    width: 820px;
    max-width: 100%;
    flex-direction: row;
    align-items: flex-start;
    padding: 12px 16px;
    background-color: var(--panel);
    border-width: 1px;
    border-color: var(--line);
    border-radius: 12px;
}

.dock__group--wind {
    flex-grow: 1;
    margin-right: 20px;
}

.dock__group--speed,
.dock__group--xray,
.dock__group--fault {
    margin-right: 20px;
}

.dock__header {
    flex-direction: row;
    justify-content: space-between;
    align-items: center;
}

.dock__value {
    font-size: 13px;
    color: var(--ink);
}

.dashboard .wind-slider {
    margin: 4px 0 0 0;
    height: 24px;
}

.dashboard .wind-slider .unity-base-slider__tracker {
    top: 50%;
    height: 6px;
    margin-top: -3px;
    border-width: 0;
    border-radius: 3px;
    background-color: var(--track);
}

.dashboard .wind-slider .unity-base-slider__dragger,
.dashboard .wind-slider .unity-base-slider__dragger:hover,
.dashboard .wind-slider .unity-base-slider__dragger:active {
    top: 50%;
    width: 18px;
    height: 18px;
    margin-top: -9px;
    border-width: 0;
    border-radius: 9px;
    background-color: var(--ink);
}

.dashboard .wind-slider .unity-base-slider__dragger-border {
    display: none;
}

.wind-ticks {
    height: 14px;
}

.wind-tick {
    position: absolute;
    top: 0;
    translate: -50% 0;
    font-size: 10px;
    color: var(--muted);
    white-space: nowrap;
}

/* Tick positions on the 0-30 m/s slider range. */
.wind-tick--cut-in { left: 10%; }
.wind-tick--rated { left: 36.7%; }
.wind-tick--cut-out { left: 83.3%; }

/* ---------- Bottom sheet (phone only, see the portrait section for sliding) ---------- */

.sheet {
    display: none;
}

/* Tap and swipe target: the whole strip, not just the thin handle. */
.sheet__header {
    padding-top: 8px;
}

.sheet__handle {
    width: 44px;
    height: 4px;
    border-radius: 2px;
    align-self: center;
    background-color: var(--line-strong);
}

.sheet__tabs {
    margin-top: 8px;
}

/* Larger touch targets than the chart tabs (four classes: outranks the portrait tab size further down). */
.dashboard .sheet .sheet__tabs .tab {
    font-size: 13px;
    padding: 6px 14px;
    margin-left: 0;
    margin-right: 4px;
}

/*
 * Same height for every page, so switching tabs does not resize the sheet (default here, measured by DashboardLayout). Hidden while closed: the top of the
 * content stays on screen under the header (see .sheet margin-bottom) and must not catch taps there.
 * The delay hides it only after the fade-out.
 */
.sheet__content {
    height: 248px;
    margin-top: 12px;
    opacity: 0;
    visibility: hidden;
    transition-property: opacity, visibility;
    transition-duration: 0.2s, 0s;
    transition-delay: 0s, 0.2s;
}

.sheet--open .sheet__content {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s, 0s;
}

.sheet__page {
    display: none;
    flex-grow: 1;
}

.sheet__page--on {
    display: flex;
}

/* The sheet itself is the card: cards moved in here lose their own frame (outranks .dashboard--portrait .card). */
.dashboard .sheet .card {
    flex-grow: 1;
    margin: 0;
    padding: 0;
    border-width: 0;
    background-color: rgba(0, 0, 0, 0);
}

.sheet .chart {
    flex-grow: 1;
    height: auto;
}

.dashboard .sheet .card__header .tab {
    padding: 4px 10px;
}

/* More page: energy, simulation speed and data source, separated by hairlines. */
.sheet-more__section {
    padding-bottom: 12px;
    margin-bottom: 12px;
    border-bottom-width: 1px;
    border-color: var(--line);
}

.sheet-more__section--last {
    padding-bottom: 0;
    margin-bottom: 0;
    border-bottom-width: 0;
}

.dashboard .sheet .energy-card {
    flex-grow: 0;
}

.sheet .dock__group--speed {
    margin-right: 0;
}

.dashboard .sheet .segmented__item {
    flex-grow: 1;
    padding: 8px 0;
    font-size: 14px;
}

.sheet-more__meta {
    flex-direction: row;
    margin-top: 6px;
}

.sheet .top-bar__meta {
    justify-content: flex-start;
    flex-grow: 0;
    flex-basis: auto;
}

.sheet-more__note {
    margin-top: 6px;
    font-size: 12px;
    color: var(--muted);
    white-space: normal;
}

/* =================== Phone (portrait) =================== */

.dashboard--portrait .top-bar {
    height: auto;
    padding: 14px 16px 10px 16px;
    background-color: rgba(10, 19, 26, 0.55);
    border-bottom-width: 0;
}

.dashboard--portrait .top-bar__brand {
    flex-direction: column;
    align-items: flex-start;
}

.dashboard--portrait .turbine-class {
    margin-left: 0;
    margin-top: 2px;
}

/* The pill is right-aligned on phones, so its width may follow the text. */
.dashboard--portrait .pill {
    min-width: 0;
}

/* Phone type scale: nothing below 11 px (iOS minimum), secondary text at 12 px. */
.dashboard--portrait .card__label {
    font-size: 13px;
}

.dashboard--portrait .card__aside,
.dashboard--portrait .turbine-class,
.dashboard--portrait .dashboard .tab {
    font-size: 12px;
}

.dashboard--portrait .wind-tick {
    font-size: 11px;
}

.dashboard--portrait .dock__value {
    font-size: 14px;
}

/* Charts, energy, sim speed and data source are not hidden: DashboardLayout moves them into the bottom sheet. */
.dashboard--portrait .right-column,
.dashboard--portrait .card__aside--wide,
.dashboard--portrait .card__footer--wide,
.dashboard--portrait .temp-scale,
.dashboard--portrait #xray-group,
.dashboard--portrait #fault-group {
    display: none;
}

/*
 * Explanation bubble under the pill. DashboardLayout moves it to the end of the scene space so it draws above the
 * X-Ray button (UI Toolkit has no z-index; later siblings draw on top). StatusBarPresenter adds .dashboard--explain
 * on state changes and on pill tap.
 */
.dashboard--portrait .state-explanation {
    position: absolute;
    top: 6px;
    right: 0;
    width: 240px;
    margin: 0;
    padding: 8px 12px;
    white-space: normal;
    font-size: 14px;
    background-color: var(--panel-solid);
    border-width: 1px;
    border-color: var(--line-strong);
    border-radius: 8px;
    opacity: 0;
    translate: 0 -4px;
    transition-property: opacity, translate;
    transition-duration: 0.3s;
}

.dashboard--portrait.dashboard--explain .state-explanation {
    opacity: 1;
    translate: 0 0;
}

/* The banner takes the same spot on phones and already says what matters most. */
.dashboard--portrait.dashboard--banner .state-explanation {
    opacity: 0;
}

.dashboard--portrait .notification-area {
    top: 6px;
}

.dashboard--portrait .notification__message {
    font-size: 14px;
}

/* column-reverse puts the free scene space on top and the value cards just above the controls. */
.dashboard--portrait .body {
    flex-direction: column-reverse;
    padding: 0 12px;
}

.dashboard--portrait .left-column {
    width: auto;
}

/* Bottom right, just above the power card: in thumb reach and clear of the explanation bubble at the top. */
.dashboard--portrait .scene-actions {
    display: flex;
    position: absolute;
    bottom: 12px;
    right: 0;
}

.dashboard--portrait .card {
    margin-bottom: 8px;
}

.dashboard--portrait .value--hero {
    font-size: 40px;
}

.dashboard--portrait .kpi-list {
    flex-direction: row;
    margin: 0 -4px;
}

.dashboard--portrait .kpi-card {
    flex-grow: 1;
    flex-basis: 0;
    margin: 0 4px 8px 4px;
    padding: 9px 10px;
}

.dashboard--portrait .kpi-card .value {
    font-size: 24px;
}

.dashboard--portrait .kpi-card .unit {
    font-size: 12px;
    margin-left: 3px;
    margin-bottom: 3px;
}

.dashboard--portrait .kpi-card .card__header {
    flex-direction: column;
    align-items: flex-start;
}

.dashboard--portrait .kpi-card .chip {
    font-size: 11px;
    padding: 0 5px;
    margin-top: 3px;
}

.dashboard--portrait .scene-space {
    margin: 0;
}

.dashboard--portrait .dock {
    align-self: stretch;
    width: auto;
    max-width: none;
    margin: 0 12px 8px 12px;
    padding: 8px 14px 6px 14px;
}

.dashboard--portrait .dock__group--wind {
    margin-right: 14px;
}

/* Reset sits at the end of the wind row on phones, with a finger-sized button. */
.dashboard--portrait .dock__group--reset .segmented__item {
    padding: 7px 12px;
    font-size: 13px;
}

/*
 * The sheet stays in the layout at its full height, but the negative bottom margin (= content height + margin)
 * lets the content hang below the screen edge, so only the header reserves space above the dock. Opening slides the
 * whole sheet up by the same amount, over the value cards and the dock. Translate animates on the GPU, no relayout.
 * DashboardLayout measures the content height (open sheet ends just above the power card) and sets the margin and
 * the translate inline; -260 matches the 248 + 12 defaults until then.
 * The bottom padding is small because the safe-area spacer adds the home indicator height.
 */
.dashboard--portrait .sheet {
    display: flex;
    margin-bottom: -260px;
    padding: 0 16px 12px 16px;
    background-color: var(--panel-solid);
    border-width: 1px 1px 0 1px;
    border-color: var(--line-strong);
    border-top-left-radius: 18px;
    border-top-right-radius: 18px;
    transition-property: translate;
    transition-duration: 0.3s;
    transition-timing-function: ease-out-cubic;
}

/* While the finger drags the sheet it must stick to the finger: no transition. Declared after, so it wins. */
.dashboard--portrait .sheet--dragging {
    transition-duration: 0s;
}

/* Content shows as soon as a drag starts, not only once the sheet has settled open. */
.sheet--dragging .sheet__content {
    opacity: 1;
    visibility: visible;
    transition-delay: 0s, 0s;
}

/* =================== Phone held sideways =================== */

/* Sibling of .dashboard, so it sets its own font and fills the panel by itself. */
.rotate-hint {
    display: none;
    position: absolute;
    left: 0;
    top: 0;
    right: 0;
    bottom: 0;
    align-items: center;
    justify-content: center;
    padding: 0 32px;
    background-color: rgba(13, 24, 32, 0.94);
    -unity-font-definition: url("Fonts/Barlow-Regular SDF.asset");
}

.dashboard--rotate .rotate-hint {
    display: flex;
}

.rotate-hint__phone {
    width: 30px;
    height: 50px;
    border-width: 2px;
    border-radius: 7px;
    border-color: var(--accent);
    align-items: center;
}

.rotate-hint__notch {
    width: 10px;
    height: 2px;
    margin-top: 4px;
    border-radius: 1px;
    background-color: var(--accent);
}

.rotate-hint__title {
    margin-top: 16px;
    -unity-font-definition: url("Fonts/BarlowCondensed-SemiBold SDF.asset");
    font-size: 20px;
    letter-spacing: 0.4px;
    color: var(--ink);
}

.rotate-hint__message {
    margin-top: 6px;
    max-width: 360px;
    font-size: 14px;
    color: var(--ink-2);
    white-space: normal;
    -unity-text-align: upper-center;
}

/* Debug readout from WindFarm.Debugging.FrameRateOverlay (added to the root, outside .dashboard). */
.fps-overlay {
    position: absolute;
    left: 8px;
    bottom: 50%;
    padding: 2px 6px;
    border-radius: 4px;
    background-color: rgba(0, 0, 0, 0.6);
    -unity-font-definition: url("Fonts/IBMPlexMono-Regular SDF.asset");
    font-size: 11px;
    color: #FFFFFF;
}

/* =================== Low landscape screens =================== */

.dashboard--short .energy-card,
.dashboard--short #curve-card {
    display: none;
}

.dashboard--short .value--hero {
    font-size: 34px;
}

.dashboard--short .body {
    padding: 10px 16px;
}
